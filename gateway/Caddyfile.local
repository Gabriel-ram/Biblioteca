# =============================================================================
# Caddyfile.local — Modo A: desarrollo local sin autenticación
# Usar con docker compose up (override automático publica puertos de servicios)
# =============================================================================

:80 {
    # Cabeceras de seguridad
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }

    # Compresión gzip
    encode gzip

    # Límite de cuerpo de petición: 1 MB
    request_body {
        max_size 1MB
    }

    # ------------------------------------------------------------------
    # Healthcheck del gateway (sin autenticación, para docker healthcheck)
    # ------------------------------------------------------------------
    handle /healthz {
        respond "OK" 200
    }

    # ------------------------------------------------------------------
    # API — Catálogo (puerto 8001)
    # ------------------------------------------------------------------
    handle_path /api/catalogo/* {
        reverse_proxy catalogo:8001
    }

    # ------------------------------------------------------------------
    # API — Préstamos (puerto 8002)
    # ------------------------------------------------------------------
    handle_path /api/prestamos/* {
        reverse_proxy prestamos:8002
    }

    # ------------------------------------------------------------------
    # API — Notificaciones (puerto 8003)
    # BLOQUEAR: POST /notificar (endpoint interno, no expuesto al público)
    # PERMITIR: GET /notificaciones* y POST /notificaciones/*/reintentar
    # ------------------------------------------------------------------

    # Bloquear siempre POST /notificar
    @bloquear_notificar {
        method POST
        path /api/notificaciones/notificar
    }
    handle @bloquear_notificar {
        respond 404
    }

    # Solo GET en /notificaciones y POST en /reintentar
    @notificaciones_permitido {
        method GET
        path /api/notificaciones/notificaciones*
    }
    @notificaciones_reintentar {
        method POST
        path /api/notificaciones/notificaciones/*/reintentar
    }

    handle_path /api/notificaciones/* {
        @get_only method GET
        @reintentar {
            method POST
            path /notificaciones/*/reintentar
        }
        route {
            handle @get_only {
                reverse_proxy notificaciones:8003
            }
            handle @reintentar {
                reverse_proxy notificaciones:8003
            }
            handle {
                respond 404
            }
        }
    }

    # Cualquier otra ruta /api/* → 404
    handle /api/* {
        respond 404
    }

    # ------------------------------------------------------------------
    # Front-end estático (servido directamente por Caddy)
    # ------------------------------------------------------------------
    handle /* {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
