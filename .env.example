# =============================================================================
# .env.example — Variables de entorno del Sistema de Biblioteca
# Copia este archivo a .env y ajusta los valores para tu entorno.
# NUNCA incluyas credenciales reales en este archivo.
# SEGURIDAD: el campo 'ci' (número de identidad) NUNCA debe aparecer en logs
#            ni en correos de notificación.
# =============================================================================

# -----------------------------------------------------------------------------
# COMPOSE — PERFILES ACTIVOS POR DEFECTO
# -----------------------------------------------------------------------------

# Activa el perfil "mail" automáticamente (Mailpit SMTP de prueba).
# En producción, elimina esta línea o deja vacío para no arrancar Mailpit.
COMPOSE_PROFILES=mail

# -----------------------------------------------------------------------------
# GENERALES
# -----------------------------------------------------------------------------

# Zona horaria para los contenedores (TZ database name)
TZ=America/La_Paz

# Puerto público del gateway Caddy (modo A y B)
GATEWAY_PORT=8080

# Caddyfile a usar: ./gateway/Caddyfile.local (sin auth) o ./gateway/Caddyfile.secure (con auth)
CADDYFILE=./gateway/Caddyfile.local

# Dirección del sitio en modo C (dominio real, ej: biblioteca.midominio.com)
# En modo B dejar vacío o usar ":80"
SITE_ADDRESS=:80

# Credenciales de autenticación básica en el gateway (modos B y C)
# El hash se genera con: caddy hash-password --plaintext "tu_contraseña"
# IMPORTANTE: los $ en el hash deben escaparse como $$ en este archivo
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=$$2a$$14$$examplehashreplaceme1234567890abcde

# Número de workers de Gunicorn para Catálogo y Préstamos (Notificaciones siempre usa 1)
WORKERS=2

# -----------------------------------------------------------------------------
# PRÉSTAMOS
# -----------------------------------------------------------------------------

# URL interna del servicio Catálogo (DNS de Docker)
CATALOGO_URL=http://catalogo:8001

# URL interna del servicio Notificaciones (DNS de Docker)
NOTIFICACIONES_URL=http://notificaciones:8003

# Timeouts HTTP en segundos (connect, read)
CATALOGO_TIMEOUT=3
NOTIFICACIONES_TIMEOUT=2

# Días de préstamo antes de vencer
DIAS_PRESTAMO=7

# Multa por día de retraso (en la moneda local)
MULTA_POR_DIA=5

# Días de antelación para enviar aviso de vencimiento
DIAS_AVISO=2

# Enviar notificación al crear un préstamo (true/false)
NOTIFICAR_PRESTAMO=true

# -----------------------------------------------------------------------------
# NOTIFICACIONES / SMTP
# -----------------------------------------------------------------------------

# Host del servidor SMTP
# Para Mailpit (desarrollo): mailpit
# Para Gmail: smtp.gmail.com
SMTP_HOST=mailpit

# Puerto SMTP
# Mailpit: 1025 | Gmail STARTTLS: 587 | Gmail SSL: 465
SMTP_PORT=1025

# Usuario SMTP (correo de la cuenta)
# Para Mailpit: puede dejarse vacío
SMTP_USER=

# Contraseña SMTP
# Para Gmail: usar contraseña de aplicación (NO la contraseña de la cuenta)
# NUNCA incluyas la contraseña real aquí
SMTP_PASSWORD=

# Modo de conexión SMTP: none | starttls | ssl
# Mailpit: none | Gmail: starttls
SMTP_MODE=none

# Timeout de conexión SMTP en segundos
SMTP_TIMEOUT=10

# Dirección de remitente
MAIL_FROM=biblioteca@example.com

# Nombre del remitente
MAIL_FROM_NAME=Sistema Biblioteca

# Texto de contacto de la biblioteca (aparece en el pie de los correos)
BIBLIOTECA_CONTACTO=Biblioteca Central — contacto@biblioteca.example.com

# Intervalo del worker de notificaciones en segundos
WORKER_INTERVAL=5

# Máximo de intentos de reenvío antes de marcar como FALLIDA
MAX_INTENTOS=5
